# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI Service
# Primary AI - Gemini 1.5 Flash (free tier, 1M token context)
GEMINI_API_KEY=your_gemini_api_key_here

# Speed Layer - Groq + Llama 3.1 70B (free tier, 500+ tokens/sec)
GROQ_API_KEY=your_groq_api_key_here

# Embeddings - Cohere (free tier)
COHERE_API_KEY=your_cohere_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
API_VERSION=v1

# Rate Limiting
RATE_LIMIT_STANDARD=100
RATE_LIMIT_AI=10
RATE_LIMIT_AUTH=5

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Logging
LOG_LEVEL=info

# Optional: Astrology API (if using external service)
ASTROLOGY_API_KEY=your_astrology_api_key_here
ASTROLOGY_API_URL=https://api.astrology-service.com

# Optional: Geocoding (for place of birth)
GEOCODING_API_KEY=your_geocoding_api_key_here
