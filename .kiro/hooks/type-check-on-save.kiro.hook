{
  "enabled": true,
  "name": "Type Check on Save",
  "description": "Run TypeScript type checking when TS files are saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run type-check"
  }
}